index 0000000..8ce232a
--- /dev/null
+++ b/crates/tor-js-wasm/src/pool.rs
@@ -0,0 +1,343 @@
+//! HTTP/1.1 keep-alive pool (fork addition).
+//!
+//! Stock tor-js opens a new Tor stream, a new exit-side TCP connection and a
+//! new TLS session for every fetch, and sends `Connection: close`. That is
+//! about three circuit round trips per warm request (BEGIN/CONNECTED, TLS,
+//! request). Keeping the finished connection lets the next request to the same
+//! origin under the same isolation group cost one.
+//!
+//! Privacy rules, enforced by the key and by what may enter the pool:
+//!
+//! * The key is (isolation group, scheme, host, port). The group is the Arti
+//!   `IsolationToken` of the caller's `anonOptions.isolationKey` (`None` for
+//!   requests without a key, which already share circuits and a TLS session
+//!   cache). Two keys never share a token, so they never share a connection:
+//!   no lookup can return another group's entry.
+//! * A connection lives at most `MAX_AGE_MS` (4 min), below Arti's 10-minute circuit
+//!   dirtiness, and is dropped after `IDLE_TIMEOUT_MS` unused. A pooled stream
+//!   therefore cannot pin one group to one exit much longer than stock would.
+//! * Only connections whose last response ended exactly on its framing go back
+//!   in (see `BodyReader` in fetch.rs); anything ambiguous is closed.
+//!
+//! The pool is generic over the connection type so its rules are testable
+//! without a network; lib.rs instantiates it with `fetch::BoxedIo`. Time is
+//! passed in (milliseconds), for the same reason.
+
+use arti_client::IsolationToken;
+
+/// Drop a connection unused for this long. Servers commonly close idle
+/// keep-alive connections after 5-120 s; a connection they closed is caught by
+/// the liveness check, so this mainly bounds how long an exit holds a TCP
+/// connection open for us.
+pub(crate) const IDLE_TIMEOUT_MS: f64 = 60_000.0;
+
+/// Drop a connection this long after it was opened, however busy. Kept below
+/// Arti's 10-minute `max_dirtiness`, so a group's requests do not ride one
+/// exit for much longer than stock circuit rotation allows.
+///
+/// Lowered from 5 to 4 minutes: in both 15-minute soaks on 2026-11-06 a
+/// pooled publicnode connection stopped answering, with no EOF and no error,
+/// at 265 s and 278 s of age, just before the 5-minute retirement.
+pub(crate) const MAX_AGE_MS: f64 = 240_000.0;
+
+/// How long a request that rides a *reused* connection waits for its response
+/// head before the connection is presumed silently dead (a stall gives no EOF,
+/// so the liveness check on take cannot see it). The request is then sent once
+/// more on a fresh connection under the same key. Applies only to requests
+/// that may be repeated (see `reused_headers_deadline`). A JSON-RPC read on a
+/// warm connection answers in 0.25-0.65 s (p50 about 0.3-0.5 s), so 5 s is
+/// about 10 times the usual answer while still well inside a caller's 15 s.
+pub(crate) const REUSED_HEADERS_TIMEOUT_MS: u32 = 5_000;
+
+/// Bounds for a caller-chosen `anonOptions.reusedHeadersTimeoutMs`.
+pub(crate) const REUSED_HEADERS_TIMEOUT_MIN_MS: u32 = 1_000;
+pub(crate) const REUSED_HEADERS_TIMEOUT_MAX_MS: u32 = 120_000;
+
+/// Idle connections kept per (group, origin). Raised from 4 to 8 so a burst
+/// of 8 in flight under one key finds a warm connection for every request
+/// (with 4, half of an 8-wide burst opened fresh connections). Costs up to 8
+/// idle TCP connections from one exit to one provider per key, each still
+/// bounded by the idle timeout and maximum age below.
+pub(crate) const MAX_IDLE_PER_ORIGIN: usize = 8;
+
+/// Idle connections kept across all groups. Bookkeeping only: nothing is
+/// shared between groups, this just bounds open Tor streams.
+pub(crate) const MAX_IDLE_TOTAL: usize = 64;
+
+/// Requests per connection before it is retired.
+pub(crate) const MAX_USES: u32 = 1000;
+
+/// Where a connection goes: one isolation group and one origin.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct PoolKey {
+    pub(crate) group: Option<IsolationToken>,
+    pub(crate) scheme: String,
+    pub(crate) host: String,
+    pub(crate) port: u16,
+}
+
+struct Idle<C> {
+    key: PoolKey,
+    conn: C,
+    created: f64,
+    idle_since: f64,
+    uses: u32,
+}
+
+/// A connection taken out of the pool, with what `put` needs to return it.
+pub(crate) struct Taken<C> {
+    pub(crate) conn: C,
+    pub(crate) created: f64,
+    pub(crate) uses: u32,
+}
+
+pub(crate) struct Pool<C> {
+    /// Oldest first. Small (at most `MAX_IDLE_TOTAL`), so a linear scan is fine.
+    idle: Vec<Idle<C>>,
+}
+
+impl<C> Default for Pool<C> {
+    fn default() -> Self {
+        Self { idle: Vec::new() }
+    }
+}
+
+/// Still young enough to use or keep. A clock that went backwards counts as
+/// expired.
+fn within_age(created: f64, uses: u32, now: f64) -> bool {
+    let age = now - created;
+    (0.0..MAX_AGE_MS).contains(&age) && uses < MAX_USES
+}
+
+/// Whether a request may go out on a pooled connection at all.
+///
+/// Only a request that could be sent again if the connection turns out dead:
+/// its body is in memory, the caller did not ask for `Connection: close`, and
+/// it is replayable (GET/HEAD/OPTIONS, or `anonOptions.idempotent`). A request
+/// that must not be repeated (a transaction broadcast, a proof submission)
+/// always gets a fresh connection, as in stock tor-js, so a stale pooled
+/// connection can never leave it in an "was it sent?" state. Its connection
+/// may still be pooled afterwards for later reads.
+pub(crate) fn may_take_pooled(caller_close: bool, in_memory: bool, replayable: bool) -> bool {
+    !caller_close && in_memory && replayable
+}
+
+/// The response-head deadline for one attempt, if any: only on a reused
+/// connection and only for a replayable request. `requested` is the caller's
+/// `anonOptions.reusedHeadersTimeoutMs`: 0 turns the deadline off (for
+/// requests whose server time is long, such as deep `eth_getLogs`), any other
+/// value is clamped to [1 s, 120 s], and none means the 5 s default.
+pub(crate) fn reused_headers_deadline(is_reuse: bool, replayable: bool, requested: Option<f64>) -> Option<u32> {
+    if !is_reuse || !replayable {
+        return None;
+    }
+    match requested {
+        None => Some(REUSED_HEADERS_TIMEOUT_MS),
+        Some(ms) if !ms.is_finite() || ms < 0.0 => Some(REUSED_HEADERS_TIMEOUT_MS),
+        Some(ms) if ms == 0.0 => None,
+        Some(ms) => Some((ms.round() as u32).clamp(REUSED_HEADERS_TIMEOUT_MIN_MS, REUSED_HEADERS_TIMEOUT_MAX_MS)),
+    }
+}
+
+impl<C> Pool<C> {
+    /// Drop every idle connection that is too old or idle too long.
+    pub(crate) fn sweep(&mut self, now: f64) {
+        self.idle.retain(|e| {
+            let idle = now - e.idle_since;
+            within_age(e.created, e.uses, now) && (0.0..IDLE_TIMEOUT_MS).contains(&idle)
+        });
+    }
+
+    /// The most recently returned idle connection for `key`, if any. Most
+    /// recent first: it is the likeliest to still be open at the server.
+    pub(crate) fn take(&mut self, key: &PoolKey, now: f64) -> Option<Taken<C>> {
+        self.sweep(now);
+        let i = self.idle.iter().rposition(|e| &e.key == key)?;
+        let e = self.idle.remove(i);
+        Some(Taken { conn: e.conn, created: e.created, uses: e.uses })
+    }
+
+    /// Return a connection after a cleanly finished exchange. `uses` counts
+    /// that exchange. Returns false (and drops it) when it is too old to keep.
+    pub(crate) fn put(&mut self, key: PoolKey, conn: C, created: f64, uses: u32, now: f64) -> bool {
+        self.sweep(now);
+        if !within_age(created, uses, now) {
+            return false;
+        }
+        if self.idle.iter().filter(|e| e.key == key).count() >= MAX_IDLE_PER_ORIGIN {
+            let oldest = self.idle.iter().position(|e| e.key == key).expect("counted above");
+            self.idle.remove(oldest);
+        }
+        if self.idle.len() >= MAX_IDLE_TOTAL {
+            self.idle.remove(0);
+        }
+        self.idle.push(Idle { key, conn, created, idle_since: now, uses });
+        true
+    }
+
+    /// Drop everything (client closed).
+    pub(crate) fn clear(&mut self) {
+        self.idle.clear();
+    }
+
+    #[cfg(test)]
+    fn len(&self) -> usize {
+        self.idle.len()
+    }
+}
