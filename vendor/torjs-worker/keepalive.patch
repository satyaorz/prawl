+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn key(group: Option<IsolationToken>, host: &str) -> PoolKey {
+        PoolKey { group, scheme: "https".into(), host: host.into(), port: 443 }
+    }
+
+    #[test]
+    fn a_returned_connection_is_reused_for_the_same_group_and_origin() {
+        let a = Some(IsolationToken::new());
+        let mut p = Pool::default();
+        assert!(p.put(key(a, "rpc.example"), 1u32, 0.0, 1, 10.0));
+        let t = p.take(&key(a, "rpc.example"), 20.0).expect("reused");
+        assert_eq!((t.conn, t.created, t.uses), (1, 0.0, 1));
+        assert!(p.take(&key(a, "rpc.example"), 20.0).is_none(), "taken exclusively");
+    }
+
+    #[test]
+    fn groups_never_share_a_connection() {
+        let (a, b) = (Some(IsolationToken::new()), Some(IsolationToken::new()));
+        let mut p = Pool::default();
+        p.put(key(a, "rpc.example"), 1u32, 0.0, 1, 0.0);
+        assert!(p.take(&key(b, "rpc.example"), 1.0).is_none(), "another key");
+        assert!(p.take(&key(None, "rpc.example"), 1.0).is_none(), "no key");
+        p.put(key(None, "rpc.example"), 2u32, 0.0, 1, 0.0);
+        assert!(p.take(&key(b, "rpc.example"), 1.0).is_none(), "unkeyed never reaches a key");
+        assert_eq!(p.take(&key(a, "rpc.example"), 1.0).unwrap().conn, 1);
+        assert_eq!(p.take(&key(None, "rpc.example"), 1.0).unwrap().conn, 2);
+    }
+
+    #[test]
+    fn origins_never_share_a_connection() {
+        let a = Some(IsolationToken::new());
+        let mut p = Pool::default();
+        p.put(key(a, "one.example"), 1u32, 0.0, 1, 0.0);
+        assert!(p.take(&key(a, "two.example"), 1.0).is_none());
+        let mut other_port = key(a, "one.example");
+        other_port.port = 8443;
+        assert!(p.take(&other_port, 1.0).is_none());
+        let mut other_scheme = key(a, "one.example");
+        other_scheme.scheme = "http".into();
+        assert!(p.take(&other_scheme, 1.0).is_none());
+    }
+
+    #[test]
+    fn idle_connections_expire() {
+        let a = Some(IsolationToken::new());
+        let mut p = Pool::default();
+        p.put(key(a, "h"), 1u32, 0.0, 1, 1000.0);
+        assert!(p.take(&key(a, "h"), 1000.0 + IDLE_TIMEOUT_MS).is_none());
+        assert_eq!(p.len(), 0);
+    }
+
+    #[test]
+    fn busy_connections_still_retire_at_max_age() {
+        let a = Some(IsolationToken::new());
+        let mut p = Pool::default();
+        // Returned a moment ago, but opened MAX_AGE_MS ago.
+        p.put(key(a, "h"), 1u32, 0.0, 5, MAX_AGE_MS - 10.0);
+        assert!(p.take(&key(a, "h"), MAX_AGE_MS).is_none());
+        // Too old to go back in at all.
+        assert!(!p.put(key(a, "h"), 2u32, 0.0, 6, MAX_AGE_MS + 1.0));
+        assert!(!p.put(key(a, "h"), 3u32, 0.0, MAX_USES, 1.0), "worn out");
+        assert_eq!(p.len(), 0);
+    }
+
+    #[test]
+    fn max_age_is_below_arti_circuit_dirtiness() {
+        assert!(MAX_AGE_MS <= 600_000.0);
+    }
+
+    #[test]
+    fn connections_retire_at_four_minutes_before_the_observed_stalls() {
+        assert_eq!(MAX_AGE_MS, 240_000.0);
+        let a = Some(IsolationToken::new());
+        let mut p = Pool::default();
+        // Both soak stalls came at 265-278 s of connection age.
+        p.put(key(a, "h"), 1u32, 0.0, 9, 230_000.0);
+        assert!(p.take(&key(a, "h"), 239_999.0).is_some(), "still usable just before 4 min");
+        p.put(key(a, "h"), 1u32, 0.0, 10, 239_999.5);
+        assert!(p.take(&key(a, "h"), 240_000.0).is_none(), "retired at 4 min");
+        assert!(!p.put(key(a, "h"), 2u32, 0.0, 3, 265_000.0), "never kept to the stall age");
+    }
+
+    #[test]
+    fn only_replayable_in_memory_requests_take_a_pooled_connection() {
+        assert!(may_take_pooled(false, true, true));
+        assert!(!may_take_pooled(false, true, false), "a write gets a fresh connection");
+        assert!(!may_take_pooled(true, true, true), "caller asked for Connection: close");
+        assert!(!may_take_pooled(false, false, true), "a streamed body can be sent only once");
+    }
+
+    #[test]
+    fn reused_deadline_applies_only_to_replayable_requests_on_reused_connections() {
+        assert_eq!(reused_headers_deadline(true, true, None), Some(5_000));
+        assert_eq!(reused_headers_deadline(false, true, None), None, "a fresh connection has no extra deadline");
+        assert_eq!(reused_headers_deadline(true, false, None), None, "never cut a request that cannot be resent");
+        assert_eq!(reused_headers_deadline(false, false, Some(3_000.0)), None);
+    }
+
+    #[test]
+    fn reused_deadline_follows_the_caller_within_bounds() {
+        assert_eq!(reused_headers_deadline(true, true, Some(0.0)), None, "0 turns it off");
+        assert_eq!(reused_headers_deadline(true, true, Some(8_000.0)), Some(8_000));
+        assert_eq!(reused_headers_deadline(true, true, Some(10.0)), Some(1_000), "clamped up");
+        assert_eq!(reused_headers_deadline(true, true, Some(1e9)), Some(120_000), "clamped down");
+        assert_eq!(reused_headers_deadline(true, true, Some(-1.0)), Some(5_000), "nonsense means default");
+        assert_eq!(reused_headers_deadline(true, true, Some(f64::NAN)), Some(5_000));
+    }
+
+    #[test]
+    fn a_clock_going_backwards_expires_rather_than_keeps() {
+        let a = Some(IsolationToken::new());
+        let mut p = Pool::default();
+        p.put(key(a, "h"), 1u32, 5000.0, 1, 5000.0);
+        assert!(p.take(&key(a, "h"), 10.0).is_none());
+    }
+
+    #[test]
+    fn idle_per_origin_is_capped_dropping_the_oldest() {
+        let a = Some(IsolationToken::new());
+        let mut p = Pool::default();
+        for i in 0..(MAX_IDLE_PER_ORIGIN as u32 + 2) {
+            p.put(key(a, "h"), i, 0.0, 1, i as f64);
+        }
+        assert_eq!(p.len(), MAX_IDLE_PER_ORIGIN);
+        // Most recent first.
+        assert_eq!(p.take(&key(a, "h"), 10.0).unwrap().conn, MAX_IDLE_PER_ORIGIN as u32 + 1);
+    }
+
+    #[test]
+    fn eight_idle_connections_per_origin_are_kept() {
+        let a = Some(IsolationToken::new());
+        let mut p = Pool::default();
+        for i in 0..8u32 {
+            p.put(key(a, "h"), i, 0.0, 1, i as f64);
+        }
+        assert_eq!(MAX_IDLE_PER_ORIGIN, 8);
+        assert_eq!(p.len(), 8);
+        for want in (0..8u32).rev() {
+            assert_eq!(p.take(&key(a, "h"), 10.0).unwrap().conn, want);
+        }
+        assert!(p.take(&key(a, "h"), 10.0).is_none());
+    }
+
+    #[test]
+    fn idle_total_is_capped() {
+        let mut p = Pool::default();
+        for i in 0..(MAX_IDLE_TOTAL + 5) {
+            p.put(key(Some(IsolationToken::new()), "h"), i, 0.0, 1, 0.0);
+        }
+        assert_eq!(p.len(), MAX_IDLE_TOTAL);
+    }
