+/// Send one request on `io` and read the response head. Resolves as soon as
+/// headers arrive; the body is read through the returned `BodyReader`, which
+/// gives `io` to `recycle` if the server allows reuse and the body ends
+/// cleanly.
+pub async fn exchange(
+    mut io: BoxedIo,
+    head: &[u8],
+    body: RequestBody,
+    method: &Method,
+    recycle: Option<Recycle>,
+) -> Result<FetchHeadersResult, ExchangeError> {
+    debug!("Sending {}-byte request head", head.len());
+    // The first write on its own, to tell "nothing left" from "partly sent".
+    let first = match io.write(head).await {
+        Ok(0) => {
+            return Err(ExchangeError::NothingSent(JsTorError::http_request(
+                "Failed to write request head: connection closed",
+            )))
+        }
+        Ok(n) => n,
+        Err(e) => {
+            return Err(ExchangeError::NothingSent(JsTorError::http_request(format!(
+                "Failed to write request head: {}",
+                e
+            ))))
+        }
+    };
+    // A later write failure: some of the request may have gone out, and no
+    // response has come back.
+    write_request(&mut io, &head[first..], body)
+        .await
+        .map_err(ExchangeError::NoResponse)?;
+
+    let mut got_any = false;
+    let parsed = read_response_head(&mut io, method, &mut got_any)
+        .await
+        .map_err(|e| {
+            if got_any {
+                ExchangeError::Failed(e)
+            } else {
+                ExchangeError::NoResponse(e)
+            }
+        })?;
+    info!("Received response headers: status={}", parsed.status);
+
+    let recycle = recycle.filter(|_| parsed.keep_alive && parsed.framing != BodyFraming::UntilEof);
+    Ok(FetchHeadersResult {
+        status: parsed.status,
+        headers: parsed.headers,
+        body_reader: BodyReader::new(io, parsed.framing, parsed.overflow).with_recycle(recycle),
+    })
+}
