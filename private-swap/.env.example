# Sepolia deployment inputs for the Prawl confidential swap.
# Copy to .env and fill in. Never commit the filled-in .env.

# JSON-RPC for Sepolia.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# A funded deployer key (0x-prefixed). It pays for deployment and seeds liquidity.
DEPLOYER_PRIVATE_KEY=

# No price feed is needed: the lot price is read from the pool the batch trades
# against (PoolLotPriceOracle). Nothing external to configure.

# Optional tuning (defaults shown).
# PRAWL_POOL_FEE=3000
# PRAWL_TICK_SPACING=60
# PRAWL_MIN_ROUND_SECONDS=60
# PRAWL_MIN_USERS=2
# PRAWL_REFUND_DELAY=3600
# PRAWL_MAX_PRICE_AGE=1800
# Optional A-side underlying units per lot. Defaults to 1 PRAWL or 0.001 WETH
# depending on the deterministic pool currency order.
# PRAWL_LOT_A_UNITS=
# PRAWL_MAX_ROUNDING_BPS=25
# PRAWL_TOKEN_SUPPLY=100000000000000000000000000
